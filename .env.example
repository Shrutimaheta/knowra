# Generate a long URL-safe password; do not use this placeholder for deployment.
POSTGRES_PASSWORD=replace_with_a_long_random_url_safe_password
APP_DB_PASSWORD=replace_with_a_different_long_random_url_safe_password
APP_ENV=development
# Deployment only: set your real hostname before using compose.production.yaml.
DOMAIN=
# Production operations: age PUBLIC recipient only. Store the matching private
# identity away from this server; it is needed for restore drills.
BACKUP_RECIPIENT=
# Operator-selected recipient; monitoring sends alerts only after you configure
# SMTP, set this address and explicitly enable the supplied systemd timer.
OPS_ALERT_TO=
PUBLIC_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: sentence-transformers/all-MiniLM-L6-v2 (install requirements-semantic first).
EMBEDDING_MODEL=
EMBEDDING_ALLOW_DOWNLOAD=false
WORKSPACE_STORAGE_MB=100
WORKSPACE_DOCUMENT_LIMIT=500
# Local OCR: maximum pages requiring OCR per PDF (1–300).
OCR_MAX_PAGES=50
# Optional SMTP (STARTTLS); development otherwise writes data/mail-outbox/*.eml.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=knowra@example.com
SMTP_USER=
SMTP_PASSWORD=
# Neon CLI populates database/Auth/storage/Function endpoints and credentials.
# Use pooled DATABASE_URL for requests and DATABASE_URL_UNPOOLED for migrations.
AUTH_PROVIDER=local
ORIGINAL_STORAGE=database
NEON_STORAGE_BUCKET=assets
# Generate a private value before `neon deploy --env .env`.
KNOWRA_FUNCTION_SECRET=
